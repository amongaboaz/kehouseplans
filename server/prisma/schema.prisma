// Prisma schema for KEPlans house-plans e-commerce API
// Database URL is configured in prisma.config.ts (Prisma 7+)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Registered customers who can place orders
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?  @default("")
  avatar    String?  @default("")
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Architectural house plan listings (digital products)
model Design {
  id           String   @id @default(uuid())
  title        String
  description  String?  @default("")
  price        Float
  category     String
  bedrooms     Int      @default(0)
  bathrooms    Int      @default(0)
  squareMeters Float    @default(0)
  images       String[]
  videos       String[]
  documents    String[]
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Customer purchase orders (items stored as JSON snapshot)
model Order {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         Json
  customerEmail String?
  paymentMethod String   @default("M-Pesa")
  subtotal      Float
  total         Float
  status        String   @default("Pending Confirmation")
  statusHistory Json
  isPaid        Boolean? @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
